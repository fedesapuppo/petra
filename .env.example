# Copy to .env and fill in. Never put real values in this file, it is committed.
#
# Tokko Broker
# Your agency API key (Tokko panel, or ask your Tokko account manager).
TOKKO_API_KEY=

# WooCommerce REST API
# WP admin -> WooCommerce -> Settings -> Advanced -> REST API -> Add key
# User: an administrator. Permissions: Read/Write.
WOO_SITE_URL=https://petrapropiedades.com
WOO_CONSUMER_KEY=ck_
WOO_CONSUMER_SECRET=cs_

# WordPress REST (application password, WP admin -> Users -> Profile)
WP_USER=tokko-sync
PETRA_APLICATION_PASSWORD=
