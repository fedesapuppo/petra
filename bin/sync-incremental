#!/usr/bin/env ruby
# Steady-state sync. Applies only what changed in Tokko.
#
#   bin/sync-incremental             dry run, changes nothing
#   bin/sync-incremental --apply     applies the plan

require_relative "../lib/env_file"
EnvFile.load

require_relative "../lib/http_json"
require_relative "../lib/woo/incremental"

begin
  Woo::Incremental.new(dry_run: !ARGV.include?("--apply")).call
rescue Woo::Incremental::Aborted => e
  warn "\nABORTED: #{e.message}"
  exit 1
rescue HttpJson::Unreachable => e
  # The host drops the odd connection from a datacenter IP, and the sync runs
  # every hour. Whatever is left undone is picked up next time, so a blip is
  # not worth a failed build. Anything the site actually answers still fails.
  warn "\nSKIPPED: the site never answered, leaving this run for the next hour. #{e.message}"
end
